+; ======================================================================
+; MeshCore-Bitchat: the T-Deck / T-Deck Plus with the Bitchat bridge. Prepared and built by
+; MeshCore-Bitchat's tools/bitchat/build_wadamesh.py, which copies the bridge into src/helpers/bitchat
+; and replaces the core's companion Bluetooth with the bridge's (same app, same PIN pairing).
+; ======================================================================
+[env:LilyGo_TDeck_companion_radio_touch_bitchat]
+extends = env:LilyGo_TDeck_companion_radio_touch
+build_unflags =
+  -std=gnu++11
+build_flags =
+  ${env:LilyGo_TDeck_companion_radio_touch.build_flags}
+  -std=gnu++17
+  ; the base env's MicroNMEA path names its own libdeps folder; this env has its own
+  -I"${platformio.libdeps_dir}/${this.__env__}/MicroNMEA/src"
+  -D WITH_BITCHAT_BRIDGE=1
+  -D CONFIG_BT_NIMBLE_MAX_CCCDS=20
+  -D CONFIG_BT_NIMBLE_MAX_BONDS=6
+  ; the bridge's buffers in PSRAM: the internal RAM stays for Bluetooth, Wi-Fi and the screen
+  -D BRIDGE_ALLOC_CAPS=MALLOC_CAP_SPIRAM
+  -D BRIDGE_HEAP_CAPS=MALLOC_CAP_SPIRAM
+build_src_filter =
+  ${env:LilyGo_TDeck_companion_radio_touch.build_src_filter}
+  +<helpers/bitchat/*.cpp>
+  +<helpers/bitchat/esp32/*.cpp>
+
